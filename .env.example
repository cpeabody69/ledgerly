# Copy to .env in this directory. Sandbox keys only, from the Plaid dashboard.
# server/index.js reads .env when the API starts. Restart after saving it.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Verification and invitation links are not sent through a mail provider.
# Outside production, GET /api/dev/mailbox reads those links on localhost.
# Set this to 0 to hide that mailbox. Production hides it unless this is 1.
LEDGERLY_DEV_MAILBOX=
