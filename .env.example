# Copy to .env in this directory. Sandbox keys only, from the Plaid dashboard.
# server/index.js reads .env when the API starts. Restart after saving it.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Verification and invitation links are not sent through a mail provider.
# Outside production, GET /api/dev/mailbox reads those links on localhost.
# Set this to 0 to hide that mailbox. Production hides it unless this is 1.
LEDGERLY_DEV_MAILBOX=

# Stripe test mode only. Live keys are refused, and nothing here creates a real charge.
# STRIPE_SECRET_KEY is the test secret key (sk_test_...) from the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET is the signing secret from `stripe listen` or a test webhook endpoint (whsec_...).
# STRIPE_PRICE_PRACTICE and STRIPE_PRICE_FIRM are recurring price ids (price_...).
# The seat count is the Checkout quantity on the chosen price.
# server/index.js reads this file when the API starts. Restart after saving it.
# Leave these empty until you are ready to open test checkout. The plan screen explains that test keys are not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_FIRM=

# QuickBooks Online sandbox only. Intuit app credentials from developer.intuit.com.
# QUICKBOOKS_CLIENT_ID and QUICKBOOKS_CLIENT_SECRET are the app's client id and client secret.
# QUICKBOOKS_REDIRECT_URI is the redirect URI registered on that app. For `npm run dev` it is
# http://127.0.0.1:5173/api/quickbooks/callback
# QUICKBOOKS_ENV must be sandbox. Any other value refuses the connection.
# QUICKBOOKS_WEBHOOK_VERIFIER is the Intuit webhook verifier token. Webhooks are rejected until it is set.
# Leave these empty until a sandbox app exists. The Integrations page explains that, and no company is marked connected.
# server/index.js reads this file when the API starts. Restart after saving it.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENV=sandbox
QUICKBOOKS_WEBHOOK_VERIFIER=
